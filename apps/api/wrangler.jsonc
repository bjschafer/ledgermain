{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Stage 5 persistence Worker (DESIGN.md §2.1). Dumb persistence only — never
  // computes or interprets game data, beyond the envelope fields
  // (ownerId/version/updatedAt) CharacterDoc already carries for optimistic
  // concurrency. See README.md for the remaining owner-side deploy step
  // (registering the Discord Application and setting its client secret).
  "name": "ledgermain-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-03",
  "account_id": "5b51f634ca1cf16a0c47a4fcd00a5cf3",

  // Non-secret config. DISCORD_CLIENT_ID is public (OAuth client ids are not
  // secret); DISCORD_CLIENT_SECRET is set via `wrangler secret put` (README).
  "vars": {
    // Comma-separated allow-list of web-app origins permitted to (a) receive
    // the post-login redirect and (b) call this API via CORS. Never trust an
    // arbitrary caller-supplied redirect_uri/Origin — always check membership
    // in this list.
    //
    // Production origins only — deliberately no `localhost`. This list also
    // feeds the Turnstile hostname assertion (`allowedHostnames`, feedback.ts),
    // so a loopback entry here means anyone can host a page on their own
    // localhost with our public sitekey, solve the challenge, and satisfy the
    // "came from our app" check. It would equally make a plain-HTTP origin a
    // valid post-login redirect target for a real session token. Local dev
    // overrides this via `.dev.vars` (see .dev.vars.example).
    "ALLOWED_APP_ORIGINS": "https://ledgermain.whizkid.dev",
    "DISCORD_CLIENT_ID": "1523090357108346941",

    // Feedback -> GitHub-issue path (src/feedback.ts). Non-secret App
    // coordinates; the App private key (GITHUB_APP_PRIVATE_KEY) and Turnstile
    // secret (TURNSTILE_SECRET) are `wrangler secret put` values, never here.
    // The `ledgermain-feedback` App is installed on the repo below with
    // Issues: write.
    "GITHUB_APP_ID": "4310904",
    "GITHUB_APP_INSTALLATION_ID": "146878087",
    "GITHUB_FEEDBACK_REPO": "bjschafer/ledgermain",

    // The single account allowed to read stored feedback contact handles
    // (src/feedbackContacts.ts), as the `discord:<user id>` string sessions
    // carry. Not a secret: it's an identifier, and holding it grants nothing
    // without a session for that account. An empty value fails closed, so an
    // unprovisioned deploy exposes no handles rather than all of them.
    "OWNER_ID": "discord:392833842563514378",
  },

  // Three KV namespaces, split by what the data *is* rather than by who writes
  // it. KV holds only regenerable operational state, so it can be cleared
  // wholesale in an incident without losing anything; the other two hold data a
  // user gave us, which can't.
  //  - KV: session tokens (`session:<token>` -> {ownerId, createdAt}),
  //    short-lived OAuth `state` nonces (`oauthstate:<nonce>` -> redirectUri),
  //    the cached GitHub installation token, and per-IP rate-limit counters.
  //  - CHARACTERS: opaque CharacterDoc blobs, keyed `<ownerId>::<docId>`.
  //  - FEEDBACK_CONTACTS: contact handles left with feedback, keyed by the ref
  //    printed in the public issue. Everything in here expires (180 days).
  // Local `wrangler dev`/vitest-pool-workers use Miniflare's local KV
  // simulation and do not need real ids to work.
  "kv_namespaces": [
    { "binding": "KV", "id": "94d09d616b3648dfb5f9bf7d5393cce3" },
    { "binding": "CHARACTERS", "id": "c648b619c69240148cb8c5204769a3b6" },
    { "binding": "FEEDBACK_CONTACTS", "id": "16f6ba88b7874804af5b6301f9f3491a" },
  ],

  // First-party usage/health telemetry (see src/analytics.ts): one PII-free
  // data point per request. The dataset is created on first write, so no
  // pre-provisioning step is needed. Local dev / vitest-pool-workers treat the
  // binding as a Miniflare no-op.
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "ledgermain_api_requests" }],

  // Same zone as apps/web (ledgermain.whizkid.dev) — a sibling subdomain
  // keeps the two origins obviously related without sharing one origin
  // (which would reintroduce cookie/CORS complexity this design avoids).
  "routes": [{ "pattern": "api.ledgermain.whizkid.dev", "custom_domain": true }],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
