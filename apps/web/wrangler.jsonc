{
  "name": "ledgermain",
  "account_id": "5b51f634ca1cf16a0c47a4fcd00a5cf3",
  "compatibility_date": "2026-06-30",
  // Off so the app is only reachable at the custom domains below. A live
  // workers.dev subdomain bypasses zone-level WAF, bot management, and rate
  // limiting entirely, which would undercut the protections on the zones.
  "workers_dev": false,
  // The old hostname keeps serving the same bundle, which recognizes it and
  // hands that origin's local characters over to ledgermain.app
  // (src/model/legacyHost.ts). wrangler deploy replaces the Worker's whole
  // custom-domain set, so dropping it here detaches it.
  "routes": [
    { "pattern": "ledgermain.app", "custom_domain": true },
    { "pattern": "ledgermain.whizkid.dev", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
