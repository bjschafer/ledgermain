{
  "name": "@pf1/reference",
  "version": "0.0.0",
  "private": true,
  "description": "PF1e quick-reference lookup site (React + Vite): search-first, read-only, one small fetch per entry.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "predev": "bun scripts/build-ref-index.ts",
    "dev": "vite",
