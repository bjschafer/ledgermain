{
  "name": "ledgermain-reference",
  "account_id": "5b51f634ca1cf16a0c47a4fcd00a5cf3",
  "compatibility_date": "2026-06-30",
  // Off for the same reason as apps/web: a live workers.dev subdomain would
  // bypass zone-level WAF, bot management, and rate limiting on whizkid.dev.
  "workers_dev": false,
  "routes": [{ "pattern": "ledgermain-ref.whizkid.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    // Routing is hash-based, so any real path should land on the shell.
    "not_found_handling": "single-page-application",
  },
}
