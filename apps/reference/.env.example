# Feedback form (src/components/FeedbackButton.tsx). With either value unset
# (the default) the "Send feedback" button is hidden and the site makes no
# request beyond its own static data.
#
# Both are *build-time* values: Vite inlines them when `vite build` runs, so
# production sets them as Workers Builds "Build variables" on the
# `ledgermain-reference` Worker in the Cloudflare dashboard, not here and not
# in wrangler.jsonc. They take the same values as the `ledgermain` Worker's.
# The Turnstile widget must also list this site's hostname, and the API
# Worker's FEEDBACK_ONLY_ORIGINS must list its origin (apps/api/wrangler.jsonc).
#
# For local dev, copy to .env.local and point at `apps/api`'s `wrangler dev`.
VITE_API_URL=
VITE_TURNSTILE_SITEKEY=
